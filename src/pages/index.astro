---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import {createSupabaseServerClient} from '../lib/supabase-server';

const supabase = createSupabaseServerClient(
    Astro.cookies,
    Astro.request.headers.get('Cookie') ?? ''
);
const {data: {user}} = await supabase.auth.getUser();

let displayName: string | null = null;
if (user) {
    const {data} = await supabase
        .from('profiles')
        .select('display_name')
        .eq('id', user.id)
        .single();
    displayName = data?.display_name
        ?? (user.user_metadata?.display_name as string | undefined)
        ?? null;
}

const openViewerHref = user
    ? '/viewer'
    : `/account?next=${encodeURIComponent('/viewer')}&toast=info&msg=${encodeURIComponent('Please log in or create an account to open the viewer.')}`;
---
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SnapSpace</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <style>
        html { scroll-behavior: smooth; }
        html, body { overflow-x: hidden !important; overflow-y: auto !important; height: auto !important; }
    </style>
</head>
<body class="landing-page">

<div class="icons-fixed">
    <a href="/account" class={`btn ${user ? 'btn-account-user' : 'btn-account-login'}`} title="Account" aria-label="Account">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
        {user ? (displayName ?? user.email ?? 'Account') : 'LOGIN'}
    </a>
</div>

<div class="landing-layout">
    <section class="landing-hero">
        <div class="landing-bg" aria-hidden="true"></div>
        <div class="landing-bg-overlay" aria-hidden="true"></div>

        <div class="landing-hero-content">
            <h1 class="landing-title">Welcome to [SnapSpace]</h1>
            <p class="landing-tagline">
                View, inspect and download your point clouds,<br/>COLMAP data and meshes — right in your browser.
            </p>
            <a href={openViewerHref} class="btn btn-accent landing-cta">
                Go To Viewer
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
            <div class="landing-links">
                <a href="https://www.meta.com/s/8BSi1EJ8l" target="_blank" rel="noopener noreferrer" class="btn landing-link-btn" title="Meta Quest App" aria-label="Meta Quest App">
                    <img src="/icons/meta-icon.svg" width="18" height="18" alt="Meta Quest App" class="icon-white"/>
                </a>
                <a href="https://discord.gg/TQBGF292ZP" target="_blank" rel="noopener noreferrer" class="btn landing-link-btn" title="Discord Server" aria-label="Discord Community">
                    <img src="/icons/discord-icon.svg" width="18" height="18" alt="Discord" class="icon-white"/>
                </a>
            </div>
        </div>

        <a class="scroll-down" href="#about" aria-label="Scroll down for more">
            <svg class="scroll-down-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </a>
    </section>

    <section id="about" class="landing-more">
        <h2 class="landing-more-title">Everything in one place</h2>
        <p class="landing-more-sub">
            From raw captures to polished results — explore every layer of your scans directly in the browser, no install required.
        </p>
        <div class="landing-features">
            <article class="feature-card">
                <svg class="feature-card-icon" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="5" cy="6" r="1.4"/><circle cx="12" cy="4" r="1.4"/><circle cx="19" cy="7" r="1.4"/>
                    <circle cx="7" cy="12" r="1.4"/><circle cx="14" cy="11" r="1.4"/><circle cx="20" cy="14" r="1.4"/>
                    <circle cx="4" cy="18" r="1.4"/><circle cx="11" cy="19" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
                </svg>
                <h3>Point Clouds</h3>
                <p>Render millions of points smoothly and inspect your captured space from every angle.</p>
            </article>
            <article class="feature-card">
                <svg class="feature-card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                </svg>
                <h3>COLMAP Data</h3>
                <p>Review camera poses and reconstruction data to understand how each scan was built.</p>
            </article>
            <article class="feature-card">
                <svg class="feature-card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                <h3>Meshes</h3>
                <p>View and download textured 3D meshes ready for your own projects and pipelines.</p>
            </article>
        </div>
    </section>

    <Footer />
</div>

</body>
</html>

