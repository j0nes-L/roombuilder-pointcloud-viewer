                        ></path>
                    </svg>
                </div>

                <div class="landing-hero-content">
                    <h1 class="landing-title">Welcome to [SnapSpace]</h1>
                    <p class="landing-tagline">
                        View, inspect and download your point clouds,<br
                        />COLMAP data and meshes - right in your browser.
                    </p>
                    <a href={openViewerHref} class="btn btn-accent landing-cta">
                        Go To Viewer
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <div class="landing-links">
                        <a
                            href="https://www.meta.com/s/8BSi1EJ8l"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn landing-link-btn"
                            title="Meta Quest App"
                            aria-label="Meta Quest App"
                        >
                            <img
                                src="/icons/meta-icon.svg"
                                width="18"
                                height="18"
                                alt="Meta Quest App"
                                class="icon-white"
                            />
                        </a>
                    </div>
                </div>

                <a
                    class="scroll-down"
                    href="#about"
                    aria-label="Scroll down for more"
                >
                    <svg
                        class="scroll-down-icon"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </a>
            </section>

            <section id="about" class="landing-more">
                <span class="about-eyebrow">Meet SnapSpace</span>
                <h2 class="landing-more-title">
                    Digitalize your Space in minutes
                </h2>
                <p class="landing-more-sub">
                    Transforms your headset into an all-in-one spatial scanner.
                    Capture your environment and walk through the optimised
                    point cloud in under five minutes — all without ever taking
                    off your headset! You can also view and export your data for
                    further use in the companion web viewer.
                </p>

                <div class="about-video">
                    <iframe
                        src="https://www.youtube-nocookie.com/embed/tTyBfV5ph5Q?cc_load_policy=1&cc_lang_pref=en&hl=en&rel=0"
                        title="SnapSpace — Trailer"
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                    >
                    </iframe>
                </div>

                <h3 class="landing-subhead">Why SnapSpace?</h3>

                <div class="about-blocks">
                    <article class="about-block">
                        <span class="about-block-icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="9"></circle>
                                <polyline points="12 7 12 12 15 14"></polyline>
                            </svg>
                        </span>
                        <div class="about-block-text">
                            <h4>Under 5 minutes</h4>
                            <p>
                                Capture and walk your point cloud without ever
                                taking off the headset.
                            </p>
                        </div>
                    </article>
                    <article class="about-block">
                        <span class="about-block-icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M17 18H7a4 4 0 0 1-.6-7.95 5.5 5.5 0 0 1 10.7-1.2A3.75 3.75 0 0 1 17 18Z"
                                ></path>
                            </svg>
                        </span>
                        <div class="about-block-text">
                            <h4>Cloud AI pipeline</h4>
                            <p>
                                Heavy reconstruction runs in the cloud - no
                                depth sensor or extra software needed.
                            </p>
                        </div>
                    </article>
                    <article class="about-block">
                        <span class="about-block-icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect x="3" y="4" width="18" height="16" rx="2"
                                ></rect>
                                <circle cx="8.5" cy="9.5" r="1.5"></circle>
                                <path d="m21 16-5-5L5 20"></path>
                            </svg>
                        </span>
                        <div class="about-block-text">
                            <h4>From 5 images</h4>
                            <p>
                                Dense point clouds from as few as five
                                passthrough photos.
                            </p>
                        </div>
                    </article>
                    <article class="about-block">
                        <span class="about-block-icon" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M12 3v12"></path>
                                <polyline points="8 11 12 15 16 11"></polyline>
                                <path d="M5 21h14"></path>
                            </svg>
                        </span>
                        <div class="about-block-text">
                            <h4>Export anywhere</h4>
                            <p>
                                <strong>.ply</strong>, <strong>.glb</strong> or COLMAP
                                archives for Gaussian Splatting.
                            </p>
                        </div>
                    </article>
                </div>

                <h3 class="landing-subhead">See the results:</h3>

                <div class="scan-preview" id="scan-preview">
                    <div class="scan-preview-stage" id="scan-preview-stage">
                        <button
                            type="button"
                            class="btn btn-accent scan-preview-cta"
                            id="scan-preview-load"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
                                <polyline points="21 3 21 9 15 9"></polyline>
                            </svg>
                            Load Random Scan
                        </button>
                        <div
                            id="scan-preview-loading"
                            class="scan-preview-loading hidden"
                        >
                            <div class="spinner-large"></div>
                            <div
                                id="scan-preview-progress"
                                class="viewer-progress"
                            >
                                Loading…
                            </div>
                        </div>
                        <button
                            type="button"
                            id="scan-preview-next"
                            class="scan-preview-next hidden"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                            Next Scan
                        </button>
                        <div
                            id="scan-preview-hud"
                            class="point-size-control point-size-control--preview"
                        >
                            <div
                                id="scan-preview-count"
                                class="point-count-display"
                            >
                                — Points
                            </div>
                            <div class="point-size-inner">
                                <label for="scan-preview-slider">Size</label>
                                <input
                                    id="scan-preview-slider"
                                    type="range"
                                    min="0.001"
                                    max="0.05"
                                    step="0.001"
                                    value="0.016"
                                    disabled
                                />
                            </div>
                            <div id="scan-preview-model" class="model-display">
                            </div>
                        </div>
                    </div>
                    <p
                        id="scan-preview-error"
                        class="scan-preview-error hidden"
                    >
                    </p>
                </div>

