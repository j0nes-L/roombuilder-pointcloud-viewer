---
import '../styles/global.css';

const tokenHash = Astro.url.searchParams.get('token_hash') ?? '';
const type = Astro.url.searchParams.get('type') ?? 'signup';
const flow = Astro.url.searchParams.get('flow')
    ?? (type === 'recovery' ? 'recovery' : 'signup');

const valid = tokenHash.length > 0;
const errorMsg = Astro.url.searchParams.get('error') ?? '';
const hasError = errorMsg.length > 0;
const isRecovery = flow === 'recovery' || type === 'recovery';
const heading = isRecovery ? 'Reset your password' : 'Confirm your email';
const description = isRecovery
    ? 'Click the button below to continue and set a new password for your account.'
    : 'Click the button below to confirm your email address and activate your account.';
const buttonLabel = isRecovery ? 'Continue' : 'Confirm email';
const errorHeading = isRecovery ? 'Reset link invalid' : 'Confirmation failed';
---
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>SnapSpace · Confirm</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
</head>
<body class="privacy-page">

<div class="privacy-container">
    <div class="privacy-header">
        <a href="/" class="privacy-back">← Back to Viewer</a>
        <h1>Account</h1>
    </div>

    <div class="account-content">
        <div class="account-card" style="text-align:center; display:flex; flex-direction:column; align-items:center; gap:18px;">
            {hasError ? (
                <>
                    <div class="account-avatar" style="margin-bottom:0; color:var(--error);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <h2 style="font-size:18px; font-weight:600; color:var(--text-primary);">{errorHeading}</h2>
                        <p style="font-size:14px; color:var(--text-secondary); max-width:340px; margin:0 auto;">{errorMsg}</p>
                    </div>
                    <div id="resend-block" data-flow={flow} style="width:100%; max-width:320px; display:flex; flex-direction:column; gap:12px; align-items:stretch;">
                        <div id="resend-email-field" class="hidden" style="text-align:left;">
                            <label class="login-label" for="resend-email">Email</label>
                            <input id="resend-email" type="email" class="login-input" placeholder="you@example.com" autocomplete="email"/>
                        </div>
                        <p id="resend-hint" class="hidden" style="font-size:13px; color:var(--text-muted); margin:0; text-align:center;"></p>
                        <button id="resend-btn" type="button" class="btn btn-accent" style="height:40px; padding:0 28px; font-size:14px;">{isRecovery ? 'Resend reset link' : 'Resend confirmation email'}</button>
                    </div>
                    <a href="/account" class="btn" style="height:40px; padding:0 28px; font-size:14px; text-decoration:none;">Back to Login</a>
                </>
            ) : valid ? (
                <>
                    <div class="account-avatar" style="margin-bottom:0;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <h2 style="font-size:18px; font-weight:600; color:var(--text-primary);">{heading}</h2>
                        <p style="font-size:14px; color:var(--text-secondary); max-width:340px; margin:0 auto;">{description}</p>
                    </div>
                    <form method="POST" action="/api/auth/confirm" style="width:100%; display:flex; justify-content:center;">
                        <input type="hidden" name="token_hash" value={tokenHash}/>
                        <input type="hidden" name="type" value={type}/>
                        <input type="hidden" name="flow" value={flow}/>
                        <button type="submit" class="btn btn-accent" style="height:40px; padding:0 28px; font-size:14px;">{buttonLabel}</button>
                    </form>
                </>
            ) : (
                <>
                    <div class="account-avatar" style="margin-bottom:0; color:var(--error);">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <h2 style="font-size:18px; font-weight:600; color:var(--text-primary);">Invalid link</h2>
                        <p style="font-size:14px; color:var(--text-secondary); max-width:340px; margin:0 auto;">This confirmation link is invalid or incomplete. Please request a new one.</p>
                    </div>
                    <a href="/account" class="btn btn-accent" style="height:40px; padding:0 28px; font-size:14px; text-decoration:none;">Back to Login</a>
                </>
            )}
        </div>
    </div>

    <footer class="app-footer">
        <span>&copy; Jonas Ludorf</span>
        <span class="footer-sep">|</span>
        <a href="/privacy" class="footer-link">Privacy Policy</a>
        <span class="footer-sep">|</span>
        <a href="https://jonasludorf.dev/legal/" class="footer-link">Legal Note</a>
    </footer>
</div>

<script>
import {showToast} from '../scripts/toast';

const resendBlock = document.getElementById('resend-block');
if (resendBlock) {
    const flow = resendBlock.getAttribute('data-flow') ?? 'signup';
    const isRecovery = flow === 'recovery';
    const emailField = document.getElementById('resend-email-field');
    const emailInput = document.getElementById('resend-email') as HTMLInputElement | null;
    const hint = document.getElementById('resend-hint');
    const btn = document.getElementById('resend-btn') as HTMLButtonElement | null;
    const defaultLabel = btn?.textContent ?? 'Resend';

    let storedEmail = '';
    try { storedEmail = sessionStorage.getItem('ss_pending_confirm_email') ?? ''; } catch {}

    if (storedEmail && !isRecovery) {
        if (emailInput) emailInput.value = storedEmail;
        if (hint) {
            hint.textContent = `We'll resend the email to ${storedEmail}.`;
            hint.classList.remove('hidden');
        }
    } else {
        emailField?.classList.remove('hidden');
    }

    emailInput?.addEventListener('input', () => emailInput.classList.remove('input-error'));

    const endpoint = isRecovery ? '/api/auth/reset-password' : '/api/auth/resend-confirmation';
    const successMsg = isRecovery
        ? 'Reset link sent! Check your email inbox.'
        : 'Confirmation email sent! Check your inbox.';
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    btn?.addEventListener('click', async () => {
        const email = (emailInput?.value ?? '').trim();
        if (!email || !emailRegex.test(email)) {
            emailField?.classList.remove('hidden');
            emailInput?.classList.add('input-error');
            emailInput?.focus();
            showToast(email ? 'Please enter a valid email address.' : 'Please enter your email address.', 'error');
            return;
        }
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email}),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) {
                showToast(data.error ?? 'Could not send the email. Please try again.', 'error');
                btn.disabled = false;
                btn.textContent = defaultLabel;
                return;
            }
            try { sessionStorage.removeItem('ss_pending_confirm_email'); } catch {}
            showToast(successMsg, 'success', 7000);
            btn.textContent = 'Email sent';
            emailField?.classList.add('hidden');
            if (hint) {
                hint.textContent = `Sent to ${email}. Check your spam folder if it doesn't arrive.`;
                hint.classList.remove('hidden');
            }
        } catch {
            showToast('Network error. Please try again.', 'error');
            btn.disabled = false;
            btn.textContent = defaultLabel;
        }
    });
}
</script>

</body>
</html>

